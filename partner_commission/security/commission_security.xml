<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_partner_commission" model="ir.module.category">
        <field name="name">Partner Commission</field>
        <field name="description">Manage partner commission agreements and transactions.</field>
        <field name="sequence">9</field>
    </record>
    <record id="group_commission_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_partner_commission" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="group_commission_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_partner_commission" />
        <field name="implied_ids" eval="[(4, ref('group_commission_user'))]" />
    </record>
    <!-- Give the installing admin and any Settings/Administration user
         access out of the box, otherwise nobody has the group after
         install and the whole menu stays invisible. -->
    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[(4, ref('group_commission_manager'))]" />
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_commission_manager'))]" />
    </record>
</odoo>
