<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="commission_account_import_view_form" model="ir.ui.view">
        <field name="name">commission.account.import.form</field>
        <field name="model">commission.account.import</field>
        <field name="arch" type="xml">
            <form string="Import Accounts Directory">
                <group invisible="state != 'choose'">
                    <field name="file" filename="filename" />
                    <field name="filename" invisible="1" />
                    <p class="text-muted">
                        Expects columns: ACC ID, NAME, MERCH CODE, INN, OGRN,
                        Enabled, Group|COMPANY ID. Existing accounts are
                        updated by ACC ID; their Agreement, Scheme override
                        and Excluded flag are never changed by this import.
                    </p>
                </group>
                <group invisible="state != 'done'">
                    <field name="created_count" />
                    <field name="updated_count" />
                    <field name="error_count" />
                    <field name="log" widget="text" />
                </group>
                <footer>
                    <button
                        name="action_import"
                        string="Import"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'choose'"
                    />
                    <button string="Close" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_commission_account_import" model="ir.actions.act_window">
        <field name="name">Import Accounts Directory</field>
        <field name="res_model">commission.account.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
