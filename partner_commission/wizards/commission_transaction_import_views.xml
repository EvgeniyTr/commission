<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="commission_transaction_import_view_form" model="ir.ui.view">
        <field name="name">commission.transaction.import.form</field>
        <field name="model">commission.transaction.import</field>
        <field name="arch" type="xml">
            <form string="Import Transaction Registry">
                <group invisible="state != 'choose'">
                    <field name="file" filename="filename" />
                    <field name="filename" invisible="1" />
                    <field name="agreement_id" />
                    <p class="text-muted">
                        The agreement is normally resolved automatically per
                        row from the accounts directory (Id Account -&gt;
                        group -&gt; agreement). Only set a fallback above for
                        rows whose account isn't in the directory yet, or
                        isn't assigned to any agreement yet.
                    </p>
                </group>
                <group invisible="state != 'done'">
                    <field name="imported_count" />
                    <field name="skipped_count" />
                    <field name="excluded_count" />
                    <field name="error_count" />
                    <field name="log" widget="text" />
                </group>
                <footer>
                    <button
                        name="action_import"
                        string="Import"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'choose'"
                    />
                    <button
                        name="action_view_transactions"
                        string="View transactions"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'done'"
                    />
                    <button string="Close" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_commission_transaction_import" model="ir.actions.act_window">
        <field name="name">Import Transaction Registry</field>
        <field name="res_model">commission.transaction.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
