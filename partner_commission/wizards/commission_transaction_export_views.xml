<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="commission_transaction_export_view_form" model="ir.ui.view">
        <field name="name">commission.transaction.export.form</field>
        <field name="model">commission.transaction.export</field>
        <field name="arch" type="xml">
            <form string="Export Results">
                <group invisible="state != 'choose'">
                    <field name="date_from" />
                    <field name="date_to" />
                    <field name="agreement_ids" widget="many2many_tags" />
                    <p class="text-muted">
                        Leave filters empty to export every agreement / all
                        dates. Same columns, ';' delimiter and ','
                        decimal separator as the legacy "Итог.csv".
                    </p>
                </group>
                <group invisible="state != 'done'">
                    <field name="row_count" />
                    <field name="file" filename="filename" readonly="1" />
                    <field name="filename" invisible="1" />
                </group>
                <footer>
                    <button
                        name="action_export"
                        string="Export"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'choose'"
                    />
                    <button string="Close" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_commission_transaction_export" model="ir.actions.act_window">
        <field name="name">Export Results</field>
        <field name="res_model">commission.transaction.export</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
